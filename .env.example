PORT=3000
HOST=127.0.0.1
# Comma-separated exact origins. Leave empty for local development only.
ALLOWED_ORIGINS=https://robbo-game.github.io
DATABASE_URL=postgres://robbo:robbo@127.0.0.1:5432/robbo
REDIS_URL=redis://127.0.0.1:6379
PUBLIC_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:8080/
# Register a GitHub OAuth App with callback PUBLIC_URL/auth/github/callback.
# Keep actual secrets in .env or a deployment secret manager, never in Git.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
